  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "vite build",
    "deploy": "pn type:check && pn build && wrangler deploy",
    "deploy:check": "pn build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "type:check": "tsc --noEmit",
    "format:check": "biome format",
    "format:write": "biome format --write",
    "lint:check": "biome lint",
    "lint:write": "biome lint --write",
    "check-all": "biome check",
    "write-all": "biome check --write",
    "check-ci": "biome ci",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@mui/material": "9.5.0",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.17.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vite-plugin": "1.65.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "oxc-transform-react": "0.152.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.154.0"
